n5 [label="agents/dqn.py\nВыбрать случайное действие или лучшее по Q-оценкам"];
n6 [label="environment/env.py\nВыполнить step(action)"];
n7 [label="agents/replay_buffer.py\nСохранить переход"];
n8 [label="agents/dqn.py\nЕсли опыт накоплен: выбрать пакет и обучить сеть;\nобновить целевую сеть по расписанию"];
n9 [label="experiments/metrics.py\nОбновить показатели"];
n10 [label="experiments/train.py\nПо расписанию сохранить метрики и состояние агента в\nruns/"];
budget [label="Бюджет исчерпан?", shape="diamond", style="filled", fillcolor="#FEF3C7"];
end [label="experiments/train.py\nСохранить итог; закрыть среду", fillcolor="#DBEAFE"];
done [label="Эпизод завершён?", shape="diamond", style="filled", fillcolor="#FEF3C7"];
start -> n1 [label=""];
